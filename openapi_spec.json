{
  "openapi": "3.1.0",
  "info": {
    "title": "Sphincs Stateless Hash Sign - Demonstration API",
    "version": "3.0.0",
    "description": "Deterministic threshold alerts; no FIPS 205 signing or verification."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Readiness metadata",
        "responses": {
          "200": {
            "description": "Service is running"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process-local operational counts",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Evaluate example thresholds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "target_identifier": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local alert dossier"
          },
          "401": {
            "description": "Invalid API key"
          },
          "503": {
            "description": "API key not configured"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Deterministic mock response",
        "responses": {
          "200": {
            "description": "Demo response"
          },
          "401": {
            "description": "Invalid API key"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Read process-local HMAC audit history",
        "responses": {
          "200": {
            "description": "Audit entries and verified flag"
          },
          "401": {
            "description": "Invalid API key"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
